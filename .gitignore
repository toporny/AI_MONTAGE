# ==============================================================================
# .gitignore — AI Automatic Music Montage
# ==============================================================================

# --- Python ---
venv/
.venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.Python
pip-log.txt

# --- IDE / edytory ---
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject

# --- Zmienne środowiskowe ---
.env
.env.local

# ==============================================================================
# PLIKI GENEROWANE PRZEZ PROJEKT (katalogi zachowane w Git przez .gitkeep)
# ==============================================================================

# Cache analizy wideo — generowany przez: run.bat analyze
analysis/*
!analysis/.gitkeep

# Storyboard — generowany przez: run.bat create-storyboard
storyboard/*
!storyboard/.gitkeep

# Preview — generowany przez: run.bat preview
preview/*
!preview/.gitkeep

# Finalny render — generowany przez: run.bat render
output/*
!output/.gitkeep

# Fragmenty ujęć — generowane przez: run.bat export-clips
clips_4k/*
!clips_4k/.gitkeep
clips_480p/*
!clips_480p/.gitkeep

# ==============================================================================
# MODELE AI (pobierane automatycznie przez bibliotekę ultralytics)
# ==============================================================================
*.pt
*.onnx
models/

# ==============================================================================
# LOGI I PLIKI TYMCZASOWE
# ==============================================================================
montage.log
*.log
concat_*.txt
temp_segments/
*.tmp
*_tmp.txt

# ==============================================================================
# SYSTEM WINDOWS
# ==============================================================================
Thumbs.db
Thumbs.db:encryptable
desktop.ini
$RECYCLE.BIN/
*.lnk

# ==============================================================================
# macOS
# ==============================================================================
.DS_Store
.AppleDouble
.LSOverride
._*

# ==============================================================================
# LINUX
# ==============================================================================
*~
.fuse_hidden*
.Trash-*

# ==============================================================================
# DUŻE PLIKI MEDIÓW (katalogi zachowane w Git przez .gitkeep)
# ==============================================================================

# Oryginalne nagrania 4K (za duże na git — dziesiątki GB)
materialy_oryginalne/*
!materialy_oryginalne/.gitkeep

# Proxy video 480p (generowane przez: run.bat sync-proxies)
kopie_robocze_480p/*
!kopie_robocze_480p/.gitkeep

# Pliki muzyczne MP3 (prawa autorskie / duże pliki binarne)
sciezkadzwiekowa/*
!sciezkadzwiekowa/.gitkeep

# Statyczny obraz outro (katalog zachowany)
outro_image/*
!outro_image/.gitkeep

